# テスト専用のダミー値。本番の秘密情報は絶対に書かないこと。
#
# ローカル Supabase の URL / anon key / service_role key は
# `npm run db:start` の後、`npm run test:integration` が自動取得する。
# ここには実キーもローカルキーも書かない。
#
# 外部サービスはテストではモックする。実キーは置かない。
OPENAI_API_KEY=test-key
OPENAI_BASE_URL=http://127.0.0.1:1/v1
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
GOOGLE_CLIENT_SECRET=test-secret
CLOUD_GITHUB_TOKEN=test-token
CLOUD_CRON_SECRET=test-cron-secret
CLOUD_RUNNER_TOKEN=test-runner-token
