# OpenAI（単一の API キー・エンドポイントで全 LLM を利用）
# OpenAI 公式、または OpenAI 互換のエンドポイントを指定する
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 任意: バックエンドの種類。opencode のときだけ x-opencode-session を自動付与する
# 未指定の場合は OPENAI_BASE_URL / モデルID から opencode を自動判定する
# OPENAI_BACKEND=opencode

# 任意: 役割ごとのモデル。未指定なら OPENAI_MODEL、それも未指定なら gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_STRUCTURING=gpt-4o-mini
# OPENAI_MODEL_SOLVING=gpt-4o-mini

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google OAuth (Google Docs連携用)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# アプリのベースURL（OAuthコールバック用）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# MCP / エージェント連携
# ============================================================
# エージェント/MCPは、アプリ内「APIトークン」で発行したユーザートークン(cat_...)で認証する。
# 利用者はエージェント側の環境変数 CATALYST_TOKEN に設定する（サーバー側の設定は不要）。

# ユーザートークンを照合し、データを読み書きするためのサービスロールキー
# Supabase Dashboard → Settings → API → service_role key（サーバー専用。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================
# Cloudflare Workers デプロイ（Workers Builds / Git リポジトリ接続）
# ============================================================
# ビルド/デプロイは Cloudflare の Git 接続で実行される（GitHub Actions は使わない）。
#   Build command:  npx opennextjs-cloudflare build
#   Deploy command: npx wrangler deploy
#
# Cloudflare 側に設定する値（いずれも Cloudflare 内で暗号化保存・リポジトリには置かない）
# ・Build variables and secrets（ビルド時に必要／クライアントに焼き込まれる公開値）
#     NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_APP_URL
# ・Variables and Secrets（ランタイム）
#     SUPABASE_SERVICE_ROLE_KEY / OPENAI_API_KEY / OPENAI_BASE_URL /
#     OPENAI_MODEL_STRUCTURING / OPENAI_MODEL_SOLVING / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#     NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_APP_URL

# ============================================================
# クラウド作業（アプリ改善の自動実行 + ユーザー依頼）
# ============================================================
# GitHub の Codespaces を作成するためのトークン。
# classic PAT に repo と codespace スコープを付与したものを推奨。
GITHUB_CODESPACES_TOKEN=your_github_codespaces_token
# アプリ本体のリポジトリ（owner/repo）
CLOUD_GITHUB_REPO=your_owner/your_repo
# 自動で拾う Issue のラベル（未指定なら全 open Issue）
# CLOUD_AUTO_ISSUE_LABEL=katalyse:auto
CLOUD_AUTO_ENABLED=true
# 1日に自動実行する最大件数 / 1回のチェックで追加する最大件数
CLOUD_AUTO_DAILY_LIMIT=4
CLOUD_AUTO_MAX_ISSUES=4
# スケジューラとランナーが共有する秘密値（十分に長いランダム文字列）
CLOUD_CRON_SECRET=your_cron_secret
CLOUD_RUNNER_TOKEN=your_runner_token

# 同時に起動する作業環境の数 / 1ジョブの上限 / 作業環境の自動停止
CLOUD_MAX_CONCURRENT=1
CLOUD_JOB_MAX_MINUTES=30
CLOUD_CODESPACE_IDLE_MINUTES=60
CLOUD_CODESPACE_RETENTION_MINUTES=60
# CLOUD_CODESPACE_MACHINE=standardLinux32gb
# CLOUD_DEVCONTAINER_PATH=.devcontainer/cloud-agent/devcontainer.json
# CLOUD_GITHUB_REF=main

# クレジット計算: 1分あたり + トークン量（API利用額換算と大きい方）× マークアップ
CLOUD_CREDIT_PER_MINUTE=0.5
CLOUD_CREDIT_PER_1K_TOKENS=0.05
CLOUD_CREDIT_PER_USD=150
CLOUD_CREDIT_MARKUP=1
CLOUD_ESTIMATE_CREDITS=20
CLOUD_USER_DAILY_LIMIT=3

# セキュリティ（AI脅威対策）
# false の場合、変更内容を検証したうえで push/PR せず、管理者の確認待ちで停止します。
CLOUD_AUTO_PUSH=false
# 通常は false。true にすると安全確認待ちの作業環境を管理者確認用に残します。
CLOUD_KEEP_REVIEW_CODESPACE=false
# 作業がなくなってから Codespace を停止するまでのアイドル時間（分）
CLOUD_RUNNER_IDLE_MINUTES=15
# 1ジョブで許可する最大変更行数
CLOUD_MAX_DIFF_LINES=1500
# 一般ユーザー向けサンドボックス用の OS ユーザー（devcontainer で作成）
CLOUD_SANDBOX_USER=agent

# 作業環境内の opencode / opencode Zen (Go)
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
# OPENCODE_PROVIDER_ID=opencode-go

# 管理画面（クラウド作業の全体状況を表示）にしたいユーザー
# ADMIN_USER_IDS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ADMIN_EMAILS=you@example.com

# ============================================================
# ランナー（Codespaces 内）に設定する Codespaces Secrets
# ============================================================
# GitHub の Repository Settings → Codespaces → Secrets に登録する。
# CATALYST_APP_URL=https://your-app.example.com
# CATALYST_CLOUD_RUNNER_TOKEN=（上の CLOUD_RUNNER_TOKEN と同じ値）
# OPENCODE_GO_API_KEY=your_opencode_zen_go_api_key
# OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
# 任意: 複数リポジトリを扱う場合の GitHub トークン（未指定なら Codespaces の GITHUB_TOKEN）
# CATALYST_GITHUB_TOKEN=your_github_token

# ============================================================
# 10分おきのスケジューラ（別 Worker）
# ============================================================
# npm run deploy:scheduler の前に、workers/cloud-scheduler で以下を設定する。
#   npx wrangler secret put CLOUD_APP_URL
#   npx wrangler secret put CLOUD_CRON_SECRET
