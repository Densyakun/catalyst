# OpenAI（単一の API キー・エンドポイントで全 LLM を利用）
# OpenAI 公式、または OpenAI 互換のエンドポイントを指定する
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 任意: バックエンドの種類。opencode のときだけ x-opencode-session を自動付与する
# 未指定の場合は OPENAI_BASE_URL / モデルID から opencode を自動判定する
# OPENAI_BACKEND=opencode

# 任意: 役割ごとのモデル。未指定なら OPENAI_MODEL、それも未指定なら gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_MODEL_STRUCTURING=gpt-4o-mini
# OPENAI_MODEL_SOLVING=gpt-4o-mini

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google OAuth (Google Docs連携用)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# アプリのベースURL（OAuthコールバック用）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# MCP / エージェント連携
# ============================================================
# エージェント/MCPは、アプリ内「APIトークン」で発行したユーザートークン(cat_...)で認証する。
# 利用者はエージェント側の環境変数 CATALYST_TOKEN に設定する（サーバー側の設定は不要）。

# ユーザートークンを照合し、データを読み書きするためのサービスロールキー
# Supabase Dashboard → Settings → API → service_role key（サーバー専用。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================
# Cloudflare Workers デプロイ（Workers Builds / Git リポジトリ接続）
# ============================================================
# ビルド/デプロイは Cloudflare の Git 接続で実行される（GitHub Actions は使わない）。
#   Build command:  npx opennextjs-cloudflare build
#   Deploy command: npx wrangler deploy
#
# Cloudflare 側に設定する値（いずれも Cloudflare 内で暗号化保存・リポジトリには置かない）
# ・Build variables and secrets（ビルド時に必要／クライアントに焼き込まれる公開値）
#     NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_APP_URL
# ・Variables and Secrets（ランタイム）
#     SUPABASE_SERVICE_ROLE_KEY / OPENAI_API_KEY / OPENAI_BASE_URL /
#     OPENAI_MODEL_STRUCTURING / OPENAI_MODEL_SOLVING / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#     NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_APP_URL

# ============================================================
# クラウド作業（アプリ改善の自動実行 + ユーザー依頼）
# ============================================================
# GitHub API（Issue取得・Actions起動・PR作成）用のトークン。
# classic PAT に repo スコープを付与したものを推奨。
CLOUD_GITHUB_TOKEN=your_github_token
# 旧名。既存環境ではそのままでも動きます（CLOUD_GITHUB_TOKEN を優先）。
# GITHUB_CODESPACES_TOKEN=your_github_token
# アプリ本体のリポジトリ（owner/repo）
CLOUD_GITHUB_REPO=your_owner/your_repo
# 自動で拾う Issue のラベル（未指定なら全 open Issue）
# CLOUD_AUTO_ISSUE_LABEL=katalyse:auto
CLOUD_AUTO_ENABLED=true
# 1日に自動実行する最大件数 / 1回のチェックで追加する最大件数
CLOUD_AUTO_DAILY_LIMIT=4
CLOUD_AUTO_MAX_ISSUES=4
# 同じ Issue が失敗・時間切れになった後、再実行するまでの待ち時間（分）
# CLOUD_AUTO_RETRY_COOLDOWN_MINUTES=45
# 同じ Issue を自動実行する最大回数（直近7日）。超えたら blocked にして再実行しない
# CLOUD_AUTO_MAX_ATTEMPTS=2
# 自動実装の対象外にする Issue ラベル（カンマ区切り）
# CLOUD_AUTO_SKIP_LABELS=wontfix,duplicate,question,discussion,invalid,stale
# スケジューラとランナーが共有する秘密値（十分に長いランダム文字列）
CLOUD_CRON_SECRET=your_cron_secret
CLOUD_RUNNER_TOKEN=your_runner_token

# 同時に実行するジョブの数 / 1ジョブの上限
CLOUD_MAX_CONCURRENT=1
CLOUD_JOB_MAX_MINUTES=30
# AI から応答が返らないまま待ち続ける時間（分）。超えたら失敗として記録する
CLOUD_JOB_STALL_MINUTES=8
# ジョブ上限を超えた後、ランナー自身の終了報告を待つ猶予（分）
CLOUD_JOB_TIMEOUT_GRACE_MINUTES=5

# クレジット計算: 1分あたり + トークン量（API利用額換算と大きい方）× マークアップ
CLOUD_CREDIT_PER_MINUTE=0.5
CLOUD_CREDIT_PER_1K_TOKENS=0.05
CLOUD_CREDIT_PER_USD=150
CLOUD_CREDIT_MARKUP=1
# プレビュー環境・失敗実行・Stripe 手数料など DB に残らない運営コストの上乗せ（%）
# CLOUD_CREDIT_OVERHEAD_PERCENT=30
CLOUD_ESTIMATE_CREDITS=20
CLOUD_USER_DAILY_LIMIT=3

# ============================================================
# Stripe 決済（クレジット購入）
# ============================================================
# Stripe ダッシュボード → Developers → API keys
# STRIPE_SECRET_KEY=sk_live_...
# Stripe ダッシュボード → Developers → Webhooks（エンドポイント: /api/billing/stripe/webhook）
# 監視イベント: checkout.session.completed, checkout.session.async_payment_succeeded,
#               checkout.session.expired, charge.refunded
# STRIPE_WEBHOOK_SECRET=whsec_...
# 1円あたりに付与するクレジット。プレビュー等の運営コストを含めるなら 1 未満にする（例: 0.8）
# BILLING_CREDITS_PER_YEN=1
# 販売するクレジットパック（credits を省略すると amount_jpy × BILLING_CREDITS_PER_YEN）
# STRIPE_CREDIT_PACKS=[{"id":"starter","label":"スターター","amount_jpy":500,"credits":400},{"id":"standard","label":"スタンダード","amount_jpy":1000,"credits":800}]

# セキュリティ（AI脅威対策）
# true: 安全検査を通過した変更をブランチとして push し、PR を作成します（マージは人間が行います）。
# false: 変更内容を検証したうえで push/PR せず、管理者の確認待ちで停止します。
CLOUD_AUTO_PUSH=true
# ランナーがジョブを取得しないまま停止するまでの時間（分）
# CLOUD_RUNNER_START_TIMEOUT_MINUTES=15
# 1ジョブで許可する最大変更行数
CLOUD_MAX_DIFF_LINES=1500
# 一般ユーザー向けサンドボックス用の OS ユーザー（Actions ランナー内で作成）
CLOUD_SANDBOX_USER=agent

# 作業環境内の opencode / opencode Zen (Go)
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
# OPENCODE_PROVIDER_ID=opencode-go
# クラウドランナーが独自プロバイダ（アプリと同じ OpenAI 互換 API）を使う場合の参考単価。
# USD / 100万トークン。未設定なら opencode の報告値（不明時 0）を使う。
# KATALYST_LLM_INPUT_COST_PER_1M=0.15
# KATALYST_LLM_OUTPUT_COST_PER_1M=0.6

# 管理画面（クラウド作業の全体状況を表示）にしたいユーザー
# ADMIN_USER_IDS=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ADMIN_EMAILS=you@example.com

# ============================================================
# 10分おきのスケジューラ（別 Worker）
# ============================================================
# npm run deploy:scheduler の前に、workers/cloud-scheduler で以下を設定する。
#   npx wrangler secret put CLOUD_APP_URL
#   npx wrangler secret put CLOUD_CRON_SECRET
