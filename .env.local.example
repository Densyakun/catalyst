# Portkey（単一 API キーで全 LLM を利用）
# https://portkey.ai/docs/integrations/libraries/vercel
PORTKEY_API_KEY=your_portkey_api_key_here

# Portkey → Configs 一覧の ID 列（pc-xxxxx 形式。@ は付けない）
# モデル・フォールバックは Config 側で定義
PORTKEY_CONFIG_STRUCTURING=pc-xxxxx
PORTKEY_CONFIG_SOLVING=pc-yyyyy

# 任意: SDK 用プレースホルダー（Config の override_params が実モデルを決定）
# PORTKEY_MODEL_PLACEHOLDER=gpt-4o-mini

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google OAuth (Google Docs連携用)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# アプリのベースURL（OAuthコールバック用）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# MCP / エージェント連携
# ============================================================
# エージェント/MCPは、アプリ内「APIトークン」で発行したユーザートークン(cat_...)で認証する。
# 利用者はエージェント側の環境変数 CATALYST_TOKEN に設定する（サーバー側の設定は不要）。

# ユーザートークンを照合し、データを読み書きするためのサービスロールキー
# Supabase Dashboard → Settings → API → service_role key（サーバー専用。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================================
# Cloudflare Workers デプロイ（Workers Builds / Git リポジトリ接続）
# ============================================================
# ビルド/デプロイは Cloudflare の Git 接続で実行される（GitHub Actions は使わない）。
#   Build command:  npx opennextjs-cloudflare build
#   Deploy command: npx wrangler deploy
#
# Cloudflare 側に設定する値（いずれも Cloudflare 内で暗号化保存・リポジトリには置かない）
# ・Build variables and secrets（ビルド時に必要／クライアントに焼き込まれる公開値）
#     NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_APP_URL
# ・Variables and Secrets（ランタイム）
#     SUPABASE_SERVICE_ROLE_KEY / PORTKEY_API_KEY / PORTKEY_CONFIG_STRUCTURING /
#     PORTKEY_CONFIG_SOLVING / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
#     NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_APP_URL
