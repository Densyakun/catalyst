{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catalyst",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Worker Previews は本番設定を継承しない。秘密情報はここに書かず、
  // ステージング用の公開値だけを Cloudflare の Previews Base に設定する。
  "previews": {}
}
