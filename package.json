{
  "name": "catalyst-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "db:start": "node scripts/db-command.mjs start -x realtime,storage-api,imgproxy,studio,mailpit,edge-runtime,logflare,vector,supavisor,postgres-meta",
    "db:start:full": "node scripts/db-command.mjs start",
    "db:stop": "node scripts/db-command.mjs stop",
    "db:reset": "node scripts/db-command.mjs db reset",
    "db:push": "supabase db push",
    "mcp": "node scripts/catalyst-mcp.mjs",
    "build:cf": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:scheduler": "wrangler deploy --config workers/cloud-scheduler/wrangler.jsonc",
    "dev:scheduler": "wrangler dev --config workers/cloud-scheduler/wrangler.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opennextjs/cloudflare": "^1.20.12",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "ai": "^6.0.168",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "next": "^16.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx-safe-eval": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "supabase": "^3.1.0",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.150.0"
  }
}
